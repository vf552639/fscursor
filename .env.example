# Transaction pooler (Supabase): use port 6543; session mode uses 5432 on pooler host.
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project_ref>:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:PASSWORD@db.<project_ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=change_me_signed_cookie_secret_use_long_random_string
SESSION_COOKIE_NAME=sdmp_session
SESSION_TTL_SECONDS=1209600
BCRYPT_ROUNDS=12

RESEND_API_KEY=
EMAIL_FROM=noreply@sdmp.app
EMAIL_CONFIRM_BASE_URL=http://localhost:3100

BACKEND_CORS_ORIGINS=http://localhost:3100,http://localhost:8080,tauri://localhost
API_V1_PREFIX=/api
VITE_API_URL=http://localhost:8100/api

# Origin(ы), разрешённые в CSP connect-src для веб-панели (через nginx).
# Для локалки: http://localhost:8100 ; для прод — реальный origin API.
WEB_CSP_CONNECT_SRC=http://localhost:8100
