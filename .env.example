# Transaction pooler (Supabase): use port 6543; session mode uses 5432 on pooler host.
# User is often postgres.<project_ref> for pooler. Match pooler region to your project
# (Dashboard → Database → Connection string); wrong region → ENOTFOUND tenant errors.
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project_ref>:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Fallback when pooler is unstable (dev only): direct Postgres bypasses pooler.
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:PASSWORD@db.<project_ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<service-role-or-anon-key>
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ENCRYPTION_KEY=change_me_32_bytes_base64_key____
SECRET_KEY=change_me_secret
# Leave empty by default; in production set explicit allowed origins.
BACKEND_CORS_ORIGINS=
API_V1_PREFIX=/api
VITE_API_URL=http://localhost:8100/api
